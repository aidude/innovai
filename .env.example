# API Keys
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# API Configuration
BASE_URL=https://api.openai.com/v1

# Rate Limiting
CALLS_PER_MINUTE=60
CALLS_PER_HOUR=3000
RETRY_ATTEMPTS=3
RETRY_DELAY=2

# Logging
LOG_LEVEL=INFO
